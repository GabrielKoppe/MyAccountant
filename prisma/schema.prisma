// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================
// Enums
// =========================================

enum AccountMemberRole {
  owner
  editor
  viewer

  @@map("account_member_role")
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired

  @@map("invite_status")
}

enum SectionCountType {
  add
  subtract
  ignore
  neutral

  @@map("section_count_type")
}

enum TableSourceMethod {
  empty
  copy
  import
  template

  @@map("table_source_method")
}

// =========================================
// Auth (NextAuth v5 + Prisma Adapter)
// =========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // NextAuth relations
  oauthAccounts OAuthAccount[]
  sessions      Session[]

  // App relations
  settings          UserSettings?
  accountsCreated   Account[]       @relation("AccountCreatedBy")
  memberships       AccountMember[]
  invitesSent       AccountInvite[] @relation("InviteSentBy")
  tablesCreated     FinanceTable[]  @relation("TableCreatedBy")
  tablesUpdated     FinanceTable[]  @relation("TableUpdatedBy")
  transCreated      Transaction[]   @relation("TransactionCreatedBy")
  transUpdated      Transaction[]   @relation("TransactionUpdatedBy")
  transResponsible  Transaction[]   @relation("TransactionResponsible")
  membersAdded      AccountMember[] @relation("MemberAddedBy")
  catsCreated       Category[]      @relation("CategoryCreatedBy")
  instCreated       Institution[]   @relation("InstitutionCreatedBy")
  templatesCreated      CsvTemplate[]     @relation("TemplateCreatedBy")
  analysesCreated       SavedAnalysis[]   @relation("AnalysisCreatedBy")
  tableModelsCreated    TableTemplate[]   @relation("TableTemplateCreatedBy")
  monthsCreated         Month[]           @relation("MonthCreatedBy")
  budgetsAsMember       Budget[]          @relation("BudgetMember")

  @@map("users")
}

// Renomeado de Account (NextAuth) para evitar conflito com Account do domínio
model OAuthAccount {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// =========================================
// Domain — Account & Members
// =========================================

model Account {
  id          String   @id @default(cuid())
  name        String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  creator       User            @relation("AccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members       AccountMember[]
  invites       AccountInvite[]
  months        Month[]
  sections      Section[]
  tableTypes    TableType[]
  tables        FinanceTable[]
  transactions  Transaction[]
  categories    Category[]
  subcategories Subcategory[]
  institutions  Institution[]
  templates          CsvTemplate[]
  savedAnalyses      SavedAnalysis[]
  tableModels        TableTemplate[]
  tableModelItems    TableTemplateItem[]
  settings           AccountSettings?
  budgets            Budget[]

  @@map("accounts")
}

model AccountMember {
  accountId String            @map("account_id")
  userId    String            @map("user_id")
  role      AccountMemberRole
  addedById String?           @map("added_by_id")
  createdAt DateTime          @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("MemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([accountId, userId])
  @@index([userId])
  @@map("account_members")
}

model AccountInvite {
  id          String            @id @default(cuid())
  accountId   String            @map("account_id")
  email       String
  role        AccountMemberRole
  status      InviteStatus      @default(pending)
  invitedById String            @map("invited_by_id")
  token       String            @unique
  createdAt   DateTime          @default(now()) @map("created_at")
  acceptedAt  DateTime?         @map("accepted_at")
  expiresAt   DateTime          @map("expires_at")

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InviteSentBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email, status])
  @@index([token])
  @@map("account_invites")
}

// =========================================
// Domain — Settings
// =========================================

model AccountSettings {
  accountId                String   @id @map("account_id")
  currency                 String   @default("BRL")
  monthStartDay            Int      @default(1) @map("month_start_day")
  defaultResponsibleUserId String?  @map("default_responsible_user_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_settings")
}

model TableType {
  id            String   @id @default(cuid())
  accountId     String   @map("account_id")
  name          String
  isDefault     Boolean  @default(false) @map("is_default")
  hiddenColumns Json     @default("{}") @map("hidden_columns")
  createdAt     DateTime @default(now()) @map("created_at")

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  financeTables  FinanceTable[]
  tableTemplates TableTemplate[]
  budgets        Budget[]

  @@unique([accountId, name])
  @@map("table_types")
}

model UserSettings {
  userId      String   @id @map("user_id")
  theme       String   @default("system")
  accentColor String   @default("indigo") @map("accent_color")
  locale      String   @default("pt-BR")
  timezone    String   @default("America/Sao_Paulo")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// =========================================
// Domain — Financial Structure
// =========================================

model Month {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  year        Int
  month       Int
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User           @relation("MonthCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  tables    FinanceTable[]
  transactions Transaction[]

  @@unique([accountId, year, month])
  @@index([accountId, year, month])
  @@map("months")
}

model Section {
  id        String           @id @default(cuid())
  accountId String           @map("account_id")
  name      String
  countType SectionCountType @map("count_type")
  order     Int              @default(0)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")

  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tables       FinanceTable[]
  transactions Transaction[]
  budgets      Budget[]

  @@unique([accountId, name])
  @@map("sections")
}

model FinanceTable {
  id            String            @id @default(cuid())
  accountId     String            @map("account_id")
  monthId       String            @map("month_id")
  sectionId     String            @map("section_id")
  tableTypeId   String?           @map("table_type_id")
  name          String
  countInMonth  Boolean           @default(true) @map("count_in_month")
  sourceMethod  TableSourceMethod @default(empty) @map("source_method")
  sourceTableId String?           @map("source_table_id")
  displayOrder  Int               @default(0) @map("display_order")
  createdById   String            @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedById   String?           @map("updated_by_id")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  month        Month          @relation(fields: [monthId], references: [id], onDelete: Cascade)
  section      Section        @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  tableType    TableType?     @relation(fields: [tableTypeId], references: [id], onDelete: SetNull)
  sourceTable  FinanceTable?  @relation("TableCopiedFrom", fields: [sourceTableId], references: [id], onDelete: SetNull)
  copies       FinanceTable[] @relation("TableCopiedFrom")
  createdBy    User           @relation("TableCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?          @relation("TableUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([monthId])
  @@index([accountId, monthId, sectionId])
  @@map("finance_tables")
}

model Transaction {
  id                String   @id @default(cuid())
  accountId         String   @map("account_id")
  monthId           String   @map("month_id")
  tableId           String   @map("table_id")
  sectionId         String   @map("section_id")
  occurredOn        DateTime @map("occurred_on") @db.Date
  amountCents       BigInt   @map("amount_cents")
  description       String?
  notes             String?
  isPending         Boolean  @default(false) @map("is_pending")
  isFavorite        Boolean  @default(false) @map("is_favorite")
  categoryId        String?  @map("category_id")
  subcategoryId     String?  @map("subcategory_id")
  institutionId     String?  @map("institution_id")
  institutionText   String?  @map("institution_text")
  responsibleUserId String?  @map("responsible_user_id")
  cardInstallment   String?  @map("card_installment")
  investmentType    String?  @map("investment_type")
  metadata          Json     @default("{}")
  createdById       String   @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedById       String?  @map("updated_by_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  account         Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  month           Month        @relation(fields: [monthId], references: [id], onDelete: Cascade)
  table           FinanceTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  section         Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory     Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  institution     Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  responsibleUser User?        @relation("TransactionResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdBy       User         @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?        @relation("TransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tableId])
  @@index([accountId, monthId])
  @@index([accountId, occurredOn])
  @@index([categoryId])
  @@map("transactions")
}

model Category {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  name        String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  subcategories Subcategory[]
  transactions  Transaction[]
  budgets       Budget[]

  @@unique([accountId, name])
  @@map("categories")
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String   @map("category_id")
  accountId  String   @map("account_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([categoryId, name])
  @@map("subcategories")
}

model Institution {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  name        String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("InstitutionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([accountId, name])
  @@map("institutions")
}

// =========================================
// Domain — Sandbox de Análise
// =========================================

model SavedAnalysis {
  id               String   @id @default(cuid())
  accountId        String   @map("account_id")
  createdById      String   @map("created_by_id")
  name             String
  config           Json
  isPinned         Boolean  @default(false) @map("is_pinned")
  pinnedOrder      Int      @default(0)     @map("pinned_order")
  dashboardContext String   @default("yearly") @map("dashboard_context")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User    @relation("AnalysisCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([accountId, name])
  @@index([accountId])
  @@index([accountId, isPinned])
  @@map("saved_analyses")
}

model CsvTemplate {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  name        String
  mapping     Json
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([accountId, name])
  @@map("csv_templates")
}

// =========================================
// Domain — Modelos de Tabela
// =========================================

model TableTemplate {
  id              String   @id @default(cuid())
  accountId       String   @map("account_id")
  name            String
  description     String?
  tableTypeId     String?  @map("table_type_id")
  countInMonth    Boolean  @default(true) @map("count_in_month")
  autoApply       Boolean  @default(false) @map("auto_apply")
  autoSectionId   String?  @map("auto_section_id")
  autoTableTypeId String?  @map("auto_table_type_id")
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tableType TableType?          @relation(fields: [tableTypeId], references: [id], onDelete: SetNull)
  createdBy User                @relation("TableTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     TableTemplateItem[]

  @@unique([accountId, name])
  @@index([accountId])
  @@map("table_templates")
}

model TableTemplateItem {
  id                String   @id @default(cuid())
  templateId        String   @map("template_id")
  accountId         String   @map("account_id")
  day               Int
  amountCents       BigInt   @map("amount_cents")
  description       String?
  notes             String?
  isPending         Boolean  @default(false) @map("is_pending")
  categoryId        String?  @map("category_id")
  subcategoryId     String?  @map("subcategory_id")
  institutionId     String?  @map("institution_id")
  responsibleUserId String?  @map("responsible_user_id")
  cardInstallment   String?  @map("card_installment")
  investmentType    String?  @map("investment_type")
  displayOrder      Int      @default(0) @map("display_order")
  createdAt         DateTime @default(now()) @map("created_at")

  template  TableTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("table_template_items")
}

// =========================================
// Domain — Budget Targets (Spec 25)
// =========================================

model Budget {
  id                    String   @id @default(cuid())
  accountId             String   @map("account_id")
  name                  String?
  sectionId             String?  @map("section_id")
  categoryId            String?  @map("category_id")
  memberUserId          String?  @map("member_user_id")
  institutionId         String?  @map("institution_id")
  tableTypeId           String?  @map("table_type_id")
  amountCents           BigInt   @map("amount_cents")
  alertThresholdPercent Int      @default(80) @map("alert_threshold_percent")
  isRecurring           Boolean  @default(true) @map("is_recurring")
  showInSummary         Boolean  @default(false) @map("show_in_summary")
  year                  Int?
  month                 Int?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  section     Section?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  member      User?        @relation("BudgetMember", fields: [memberUserId], references: [id], onDelete: SetNull)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  tableType   TableType?   @relation(fields: [tableTypeId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, isRecurring])
  @@map("budgets")
}
