// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================
// Enums
// =========================================

enum AccountMemberRole {
  owner
  editor
  viewer

  @@map("account_member_role")
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired

  @@map("invite_status")
}

enum SectionCountType {
  add
  subtract
  ignore
  neutral

  @@map("section_count_type")
}

enum TableSourceMethod {
  empty
  copy
  import
  template

  @@map("table_source_method")
}

enum TransactionExpenseType {
  fixed
  variable
  one_time

  @@map("transaction_expense_type")
}

enum TransactionPaymentMethod {
  pix
  cash
  credit_card
  debit_card
  bank_transfer
  boleto
  other

  @@map("transaction_payment_method")
}

enum TransactionSource {
  manual
  csv_import
  xlsx_import
  template
  auto_template
  duplicate

  @@map("transaction_source")
}

enum TransactionLinkType {
  reimbursed_by
  paid_for
  relates_to

  @@map("transaction_link_type")
}

// =========================================
// Auth (NextAuth v5 + Prisma Adapter)
// =========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")
  passwordHash      String?   @map("password_hash")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // NextAuth relations
  oauthAccounts OAuthAccount[]
  sessions      Session[]

  // App relations
  settings                    UserSettings?
  accountsCreated             Account[]                @relation("AccountCreatedBy")
  memberships                 AccountMember[]
  invitesSent                 AccountInvite[]          @relation("InviteSentBy")
  tablesCreated               FinanceTable[]           @relation("TableCreatedBy")
  tablesUpdated               FinanceTable[]           @relation("TableUpdatedBy")
  transCreated                Transaction[]            @relation("TransactionCreatedBy")
  transUpdated                Transaction[]            @relation("TransactionUpdatedBy")
  responsiblePartyMemberships ResponsiblePartyMember[]
  membersAdded                AccountMember[]          @relation("MemberAddedBy")
  catsCreated                 Category[]               @relation("CategoryCreatedBy")
  instCreated                 Institution[]            @relation("InstitutionCreatedBy")
  templatesCreated            CsvTemplate[]            @relation("TemplateCreatedBy")
  tableModelsCreated          TableTemplate[]          @relation("TableTemplateCreatedBy")
  monthsCreated               Month[]                  @relation("MonthCreatedBy")
  budgetsAsMember             Budget[]                 @relation("BudgetMember")
  notificationsReceived       Notification[]           @relation("NotificationRecipient")
  notificationsSent           Notification[]           @relation("NotificationActor")
  checklistItemsCreated       ChecklistItem[]          @relation("ChecklistItemCreatedBy")
  checklistCompletions        ChecklistCompletion[]    @relation("ChecklistCompletedBy")
  transactionAliasesCreated   TransactionAlias[]       @relation("TransactionAliasCreatedBy")
  mcpGrants                   McpGrant[]
  passwordResetTokens         PasswordResetToken[]
  auditLogsActed              AuditLog[]               @relation("AuditLogActor")

  @@map("users")
}

// Renomeado de Account (NextAuth) para evitar conflito com Account do domínio
model OAuthAccount {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// =========================================
// Domain — Account & Members
// =========================================

model Account {
  id          String   @id @default(cuid())
  name        String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  creator              User                  @relation("AccountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members              AccountMember[]
  invites              AccountInvite[]
  months               Month[]
  sections             Section[]
  tableTypes           TableType[]
  tables               FinanceTable[]
  transactions         Transaction[]
  categories           Category[]
  subcategories        Subcategory[]
  institutions         Institution[]
  templates            CsvTemplate[]
  tableModels          TableTemplate[]
  tableModelItems      TableTemplateItem[]
  settings             AccountSettings?
  budgets              Budget[]
  notifications        Notification[]
  tags                 Tag[]
  dashboardLayouts     DashboardLayout[]
  installmentGroups    InstallmentGroup[]
  pendingInstallments  PendingInstallment[]
  transactionLinks     TransactionLink[]
  responsibleParties   ResponsibleParty[]
  checklistItems       ChecklistItem[]
  checklistCompletions ChecklistCompletion[]
  transactionAliases   TransactionAlias[]
  mcpGrants            McpGrant[]
  auditLogs            AuditLog[]

  @@map("accounts")
}

model AccountMember {
  accountId String            @map("account_id")
  userId    String            @map("user_id")
  role      AccountMemberRole
  addedById String?           @map("added_by_id")
  createdAt DateTime          @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("MemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([accountId, userId])
  @@index([userId])
  @@map("account_members")
}

model AccountInvite {
  id          String            @id @default(cuid())
  accountId   String            @map("account_id")
  email       String
  role        AccountMemberRole
  status      InviteStatus      @default(pending)
  invitedById String            @map("invited_by_id")
  token       String            @unique
  createdAt   DateTime          @default(now()) @map("created_at")
  acceptedAt  DateTime?         @map("accepted_at")
  expiresAt   DateTime          @map("expires_at")

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InviteSentBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email, status])
  @@index([token])
  @@map("account_invites")
}

// =========================================
// Domain — Settings
// =========================================

model AccountSettings {
  accountId                 String    @id @map("account_id")
  currency                  String    @default("BRL")
  monthStartDay             Int       @default(1) @map("month_start_day")
  defaultResponsiblePartyId String?   @map("default_responsible_party_id")
  invertSignOnMoveByDefault Boolean   @default(true) @map("invert_sign_on_move_by_default")
  onboardingCompletedAt     DateTime? @map("onboarding_completed_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  account                 Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  defaultResponsibleParty ResponsibleParty? @relation("SettingsDefaultResponsibleParty", fields: [defaultResponsiblePartyId], references: [id], onDelete: SetNull)

  @@map("account_settings")
}

enum ResponsiblePartyKind {
  personal
  group
  external

  @@map("responsible_party_kind")
}

model ResponsibleParty {
  id         String               @id @default(cuid())
  accountId  String               @map("account_id")
  name       String
  kind       ResponsiblePartyKind
  icon       String? // chave do set curado (src/lib/persona-icons.ts)
  color      String? // chave de cor accent (src/lib/accent-colors.ts)
  archivedAt DateTime?            @map("archived_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  account            Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  members            ResponsiblePartyMember[]
  transactions       Transaction[]            @relation("TransactionResponsibleParty")
  templateItems      TableTemplateItem[]      @relation("TemplateItemResponsibleParty")
  settingsDefaultOf  AccountSettings[]        @relation("SettingsDefaultResponsibleParty")
  transactionAliases TransactionAlias[]

  @@unique([accountId, name])
  @@index([accountId])
  @@map("responsible_parties")
}

model ResponsiblePartyMember {
  partyId String @map("party_id")
  userId  String @map("user_id")

  party ResponsibleParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([partyId, userId])
  @@index([userId])
  @@map("responsible_party_members")
}

model TableType {
  id            String   @id @default(cuid())
  accountId     String   @map("account_id")
  name          String
  isDefault     Boolean  @default(false) @map("is_default")
  hiddenColumns Json     @default("{}") @map("hidden_columns")
  createdAt     DateTime @default(now()) @map("created_at")

  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  financeTables     FinanceTable[]
  tableTemplates    TableTemplate[]
  budgets           Budget[]
  installmentGroups InstallmentGroup[]

  @@unique([accountId, name])
  @@map("table_types")
}

model UserSettings {
  userId      String   @id @map("user_id")
  theme       String   @default("system")
  accentColor String   @default("indigo") @map("accent_color")
  locale      String   @default("pt-BR")
  timezone    String   @default("America/Sao_Paulo")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// =========================================
// Domain — Financial Structure
// =========================================

model Month {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  year        Int
  month       Int
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy            User                  @relation("MonthCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  tables               FinanceTable[]
  transactions         Transaction[]
  checklistCompletions ChecklistCompletion[]

  @@unique([accountId, year, month])
  @@index([accountId, year, month])
  @@map("months")
}

model Section {
  id        String           @id @default(cuid())
  accountId String           @map("account_id")
  name      String
  countType SectionCountType @map("count_type")
  order     Int              @default(0)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")

  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tables            FinanceTable[]
  transactions      Transaction[]
  budgets           Budget[]
  installmentGroups InstallmentGroup[]

  @@unique([accountId, name])
  @@map("sections")
}

model FinanceTable {
  id            String            @id @default(cuid())
  accountId     String            @map("account_id")
  monthId       String            @map("month_id")
  sectionId     String            @map("section_id")
  tableTypeId   String?           @map("table_type_id")
  name          String
  countInMonth  Boolean           @default(true) @map("count_in_month")
  groupByDate   Boolean           @default(true) @map("group_by_date")
  sourceMethod  TableSourceMethod @default(empty) @map("source_method")
  sourceTableId String?           @map("source_table_id")
  displayOrder  Int               @default(0) @map("display_order")
  createdById   String            @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedById   String?           @map("updated_by_id")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  month        Month          @relation(fields: [monthId], references: [id], onDelete: Cascade)
  section      Section        @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  tableType    TableType?     @relation(fields: [tableTypeId], references: [id], onDelete: SetNull)
  sourceTable  FinanceTable?  @relation("TableCopiedFrom", fields: [sourceTableId], references: [id], onDelete: SetNull)
  copies       FinanceTable[] @relation("TableCopiedFrom")
  createdBy    User           @relation("TableCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?          @relation("TableUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([monthId])
  @@index([accountId, monthId, sectionId])
  @@map("finance_tables")
}

model Transaction {
  id                  String                    @id @default(cuid())
  accountId           String                    @map("account_id")
  monthId             String                    @map("month_id")
  tableId             String                    @map("table_id")
  sectionId           String                    @map("section_id")
  occurredOn          DateTime                  @map("occurred_on") @db.Date
  amountCents         BigInt                    @map("amount_cents")
  description         String?
  notes               String?
  isPending           Boolean                   @default(false) @map("is_pending")
  isFavorite          Boolean                   @default(false) @map("is_favorite")
  categoryId          String?                   @map("category_id")
  subcategoryId       String?                   @map("subcategory_id")
  institutionId       String?                   @map("institution_id")
  institutionText     String?                   @map("institution_text")
  responsiblePartyId  String?                   @map("responsible_party_id")
  cardInstallment     String?                   @map("card_installment")
  investmentType      String?                   @map("investment_type")
  expenseType         TransactionExpenseType?   @map("expense_type")
  paymentMethod       TransactionPaymentMethod? @map("payment_method")
  source              TransactionSource         @default(manual) @map("source")
  installmentGroupId  String?                   @map("installment_group_id")
  installmentNumber   Int?                      @map("installment_number")
  originalAmountCents BigInt?                   @map("original_amount_cents")
  originalCurrency    String?                   @map("original_currency")
  exchangeRate        Decimal?                  @map("exchange_rate") @db.Decimal(18, 6)
  metadata            Json                      @default("{}")
  createdById         String                    @map("created_by_id")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedById         String?                   @map("updated_by_id")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  month                Month                 @relation(fields: [monthId], references: [id], onDelete: Cascade)
  table                FinanceTable          @relation(fields: [tableId], references: [id], onDelete: Cascade)
  section              Section               @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory          Subcategory?          @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  institution          Institution?          @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  responsibleParty     ResponsibleParty?     @relation("TransactionResponsibleParty", fields: [responsiblePartyId], references: [id], onDelete: SetNull)
  createdBy            User                  @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User?                 @relation("TransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  tags                 TransactionTag[]
  installmentGroup     InstallmentGroup?     @relation(fields: [installmentGroupId], references: [id], onDelete: SetNull)
  linksAsSource        TransactionLink[]     @relation("LinkSource")
  linksAsTarget        TransactionLink[]     @relation("LinkTarget")
  // Back-relation do vínculo unilateral do checklist (FK vive em checklist_completions;
  // nenhuma coluna é adicionada em transactions). onDelete: SetNull limpa o vínculo.
  checklistCompletions ChecklistCompletion[]

  @@index([tableId])
  @@index([accountId, monthId])
  @@index([accountId, occurredOn])
  @@index([categoryId])
  @@index([installmentGroupId])
  @@index([responsiblePartyId])
  @@map("transactions")
}

model Category {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  name        String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy          User               @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  subcategories      Subcategory[]
  transactions       Transaction[]
  budgets            Budget[]
  transactionAliases TransactionAlias[]

  @@unique([accountId, name])
  @@map("categories")
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String   @map("category_id")
  accountId  String   @map("account_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")

  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  transactionAliases TransactionAlias[]

  @@unique([categoryId, name])
  @@map("subcategories")
}

model Institution {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  name        String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy          User               @relation("InstitutionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  transactions       Transaction[]
  budgets            Budget[]
  transactionAliases TransactionAlias[]

  @@unique([accountId, name])
  @@map("institutions")
}

model CsvTemplate {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  name        String
  mapping     Json
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([accountId, name])
  @@map("csv_templates")
}

// =========================================
// Domain — Modelos de Tabela
// =========================================

model TableTemplate {
  id              String   @id @default(cuid())
  accountId       String   @map("account_id")
  name            String
  description     String?
  tableTypeId     String?  @map("table_type_id")
  countInMonth    Boolean  @default(true) @map("count_in_month")
  autoApply       Boolean  @default(false) @map("auto_apply")
  autoSectionId   String?  @map("auto_section_id")
  autoTableTypeId String?  @map("auto_table_type_id")
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tableType TableType?          @relation(fields: [tableTypeId], references: [id], onDelete: SetNull)
  createdBy User                @relation("TableTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     TableTemplateItem[]

  @@unique([accountId, name])
  @@index([accountId])
  @@map("table_templates")
}

model TableTemplateItem {
  id                 String                  @id @default(cuid())
  templateId         String                  @map("template_id")
  accountId          String                  @map("account_id")
  day                Int
  amountCents        BigInt                  @map("amount_cents")
  description        String?
  notes              String?
  isPending          Boolean                 @default(false) @map("is_pending")
  categoryId         String?                 @map("category_id")
  subcategoryId      String?                 @map("subcategory_id")
  institutionId      String?                 @map("institution_id")
  responsiblePartyId String?                 @map("responsible_party_id")
  cardInstallment    String?                 @map("card_installment")
  investmentType     String?                 @map("investment_type")
  expenseType        TransactionExpenseType? @map("expense_type")
  displayOrder       Int                     @default(0) @map("display_order")
  createdAt          DateTime                @default(now()) @map("created_at")

  template         TableTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  responsibleParty ResponsibleParty? @relation("TemplateItemResponsibleParty", fields: [responsiblePartyId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@map("table_template_items")
}

// =========================================
// Domain — Budget Targets (Spec 25)
// =========================================

model Budget {
  id                    String   @id @default(cuid())
  accountId             String   @map("account_id")
  name                  String?
  sectionId             String?  @map("section_id")
  categoryId            String?  @map("category_id")
  memberUserId          String?  @map("member_user_id")
  institutionId         String?  @map("institution_id")
  tableTypeId           String?  @map("table_type_id")
  amountCents           BigInt   @map("amount_cents")
  alertThresholdPercent Int      @default(80) @map("alert_threshold_percent")
  isRecurring           Boolean  @default(true) @map("is_recurring")
  showInSummary         Boolean  @default(false) @map("show_in_summary")
  year                  Int?
  month                 Int?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  section     Section?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  member      User?        @relation("BudgetMember", fields: [memberUserId], references: [id], onDelete: SetNull)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  tableType   TableType?   @relation(fields: [tableTypeId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, isRecurring])
  @@map("budgets")
}

// =========================================
// Domain — Dashboard Layouts (Spec 33)
// =========================================

enum DashboardLayoutContext {
  monthly
  yearly
  month_summary

  @@map("dashboard_layout_context")
}

model DashboardLayout {
  id        String                 @id @default(cuid())
  accountId String                 @map("account_id")
  context   DashboardLayoutContext
  widgets   Json // StoredWidget[] (spec 36) — instâncias configuráveis em grade 2D
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, context])
  @@index([accountId])
  @@map("dashboard_layouts")
}

// =========================================
// Domain — Notifications (Spec 29)
// =========================================

model Notification {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  userId    String   @map("user_id")
  actorId   String   @map("actor_id")
  type      String
  title     String
  body      String?
  link      String?
  count     Int      @default(1)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, accountId, isRead])
  @@index([accountId])
  @@map("notifications")
}

// =========================================
// Domain — Tags (Spec 41 TRN-04)
// =========================================

model Tag {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  account      Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]
  aliasTags    TransactionAliasTag[]

  @@unique([accountId, name])
  @@index([accountId])
  @@map("tags")
}

model TransactionTag {
  transactionId String @map("transaction_id")
  tagId         String @map("tag_id")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
  @@map("transaction_tags")
}

// =========================================
// Domain — Transaction Aliases (Spec 61)
// =========================================

model TransactionAlias {
  id                String @id @default(cuid())
  accountId         String @map("account_id")
  trigger           String @map("trigger_text") // display (case original) — evita palavra reservada
  triggerNormalized String @map("trigger_normalized") // lowercase — match + unicidade

  // payload — todos opcionais (patch parcial; null = "não define")
  description         String?
  notes               String?
  amountCents         BigInt?                   @map("amount_cents") // aplica no manual; NÃO no import (DD-09)
  categoryId          String?                   @map("category_id")
  subcategoryId       String?                   @map("subcategory_id")
  institutionId       String?                   @map("institution_id")
  institutionText     String?                   @map("institution_text")
  responsiblePartyId  String?                   @map("responsible_party_id")
  expenseType         TransactionExpenseType?   @map("expense_type")
  paymentMethod       TransactionPaymentMethod? @map("payment_method")
  investmentType      String?                   @map("investment_type")
  cardInstallment     String?                   @map("card_installment")
  isPending           Boolean?                  @map("is_pending")
  isFavorite          Boolean?                  @map("is_favorite")
  originalCurrency    String?                   @map("original_currency")
  originalAmountCents BigInt?                   @map("original_amount_cents")
  exchangeRate        Decimal?                  @map("exchange_rate") @db.Decimal(18, 6)

  archivedAt  DateTime? @map("archived_at")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  account          Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy        User                  @relation("TransactionAliasCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  category         Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory      Subcategory?          @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  institution      Institution?          @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  responsibleParty ResponsibleParty?     @relation(fields: [responsiblePartyId], references: [id], onDelete: SetNull)
  tags             TransactionAliasTag[]

  @@unique([accountId, triggerNormalized])
  @@index([accountId])
  @@map("transaction_aliases")
}

model TransactionAliasTag {
  aliasId String @map("alias_id")
  tagId   String @map("tag_id")

  alias TransactionAlias @relation(fields: [aliasId], references: [id], onDelete: Cascade)
  tag   Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([aliasId, tagId])
  @@index([tagId])
  @@map("transaction_alias_tags")
}

// =========================================
// Domain — Installment Groups (Spec 41 TRN-02)
// =========================================

model InstallmentGroup {
  id               String   @id @default(cuid())
  accountId        String   @map("account_id")
  description      String
  totalCents       BigInt   @map("total_cents")
  installmentCount Int      @map("installment_count")
  downPaymentCents BigInt?  @map("down_payment_cents")
  startDate        DateTime @map("start_date") @db.Date
  sectionId        String   @map("section_id")
  tableTypeId      String?  @map("table_type_id")
  createdAt        DateTime @default(now()) @map("created_at")

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  section             Section              @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  tableType           TableType?           @relation(fields: [tableTypeId], references: [id], onDelete: SetNull)
  transactions        Transaction[]
  pendingInstallments PendingInstallment[]

  @@index([accountId])
  @@map("installment_groups")
}

model PendingInstallment {
  id                 String   @id @default(cuid())
  accountId          String   @map("account_id")
  installmentGroupId String   @map("installment_group_id")
  installmentNumber  Int      @map("installment_number")
  amountCents        BigInt   @map("amount_cents")
  expectedDate       DateTime @map("expected_date") @db.Date
  description        String?
  categoryId         String?  @map("category_id")
  subcategoryId      String?  @map("subcategory_id")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")

  account Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  group   InstallmentGroup @relation(fields: [installmentGroupId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([installmentGroupId])
  @@map("pending_installments")
}

// =========================================
// Domain — Transaction Links (Spec 41 TRN-06)
// =========================================

model TransactionLink {
  id        String              @id @default(cuid())
  accountId String              @map("account_id")
  sourceId  String              @map("source_id")
  targetId  String              @map("target_id")
  type      TransactionLinkType
  notes     String?
  createdAt DateTime            @default(now()) @map("created_at")

  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source  Transaction @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target  Transaction @relation("LinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([targetId])
  @@index([accountId])
  @@map("transaction_links")
}

// =========================================
// Domain — Monthly Checklist (Spec 36 — widget month_summary)
// =========================================

// Template recorrente compartilhado pela Account. Aparece em qualquer mês.
model ChecklistItem {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  label       String
  position    Int
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account     Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation("ChecklistItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  completions ChecklistCompletion[]

  @@unique([accountId, label])
  @@index([accountId])
  @@map("checklist_items")
}

// Estado de conclusão por mês. Linha presente = concluído; ausência = pendente.
model ChecklistCompletion {
  id            String   @id @default(cuid())
  accountId     String   @map("account_id")
  itemId        String   @map("item_id")
  monthId       String   @map("month_id")
  completedById String   @map("completed_by_id")
  // Vínculo unilateral opcional a uma transação (a que cumpriu a tarefa no mês).
  // onDelete SetNull: deletar a transação limpa o vínculo, não a conclusão.
  transactionId String?  @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at")

  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  item        ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  month       Month         @relation(fields: [monthId], references: [id], onDelete: Cascade)
  completedBy User          @relation("ChecklistCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([itemId, monthId])
  @@index([accountId])
  @@index([monthId])
  @@index([transactionId])
  @@map("checklist_completions")
}

// =========================================
// Domain — MCP OAuth Connector (Spec 63)
// =========================================

enum McpTokenType {
  access
  refresh

  @@map("mcp_token_type")
}

model McpClient {
  id           String   @id @default(cuid())
  clientId     String   @unique @map("client_id")
  clientName   String   @map("client_name")
  redirectUris String[] @map("redirect_uris")
  createdAt    DateTime @default(now()) @map("created_at")

  grants McpGrant[]

  @@map("mcp_clients")
}

model McpGrant {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  accountId  String    @map("account_id")
  clientId   String    @map("client_id")
  scope      String    @default("read")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  client  McpClient  @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  tokens  McpToken[]

  @@unique([userId, accountId, clientId])
  @@index([accountId])
  @@map("mcp_grants")
}

model McpToken {
  id        String       @id @default(cuid())
  grantId   String       @map("grant_id")
  type      McpTokenType
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")

  grant McpGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@map("mcp_tokens")
}

model McpAuthCode {
  id            String    @id @default(cuid())
  code          String    @unique
  clientId      String    @map("client_id")
  userId        String    @map("user_id")
  accountId     String    @map("account_id")
  redirectUri   String    @map("redirect_uri")
  codeChallenge String    @map("code_challenge")
  scope         String    @default("read")
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("mcp_auth_codes")
}

// =========================================
// Security (Spec 23 — SEC-08a / SEC-09)
// =========================================

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  actor   User?   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@map("audit_logs")
}
