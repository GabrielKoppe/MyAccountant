# ===== Database =====
# Em dev (docker compose): postgres é o hostname do service
DATABASE_URL="postgresql://myaccountant:dev_password@postgres:5432/myaccountant?schema=public"
# Para migrations no Neon (prod), use DIRECT_URL sem pooling
DIRECT_URL="postgresql://myaccountant:dev_password@postgres:5432/myaccountant?schema=public"

# ===== NextAuth =====
NEXTAUTH_URL="http://localhost:3000"
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ===== OAuth Google =====
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===== Email (Brevo) =====
# Chave de API gerada em: app.brevo.com/settings/keys/api
BREVO_API_KEY=""
EMAIL_FROM="MyAccountant <seuemail@gmail.com>"

# ===== Logging =====
LOG_LEVEL="debug"

# ===== Controle de acesso ao registro =====
# Lista de emails autorizados a criar conta, separados por vírgula.
# Quando não definido ou vazio, qualquer pessoa pode se cadastrar.
# Exemplo: ALLOWED_EMAILS="voce@email.com,amigo@email.com"
ALLOWED_EMAILS=""

# ===== Rate limiting (SEC-01) — obrigatório em produção =====
# Crie um Redis free em upstash.com e copie as credenciais REST.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ===== Client-side =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== MCP Connector =====
MCP_ENABLED="false"
MCP_ISSUER_URL="http://localhost:3000"
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_DAYS=90

# ===== Build (apenas Docker build, não validar) =====
# SKIP_ENV_VALIDATION="1"
