# ===== Database =====
# Em dev (docker compose): postgres é o hostname do service
DATABASE_URL="postgresql://myaccountant:dev_password@postgres:5432/myaccountant?schema=public"
# Para migrations no Neon (prod), use DIRECT_URL sem pooling
DIRECT_URL="postgresql://myaccountant:dev_password@postgres:5432/myaccountant?schema=public"

# ===== NextAuth =====
NEXTAUTH_URL="http://localhost:3000"
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ===== OAuth Google =====
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===== Email (Brevo) =====
# Seu email de login no Brevo
BREVO_SMTP_USER=""
# Chave SMTP gerada em: brevo.com → Account → SMTP & API → SMTP Keys
BREVO_SMTP_KEY=""
EMAIL_FROM="MyAccountant <seuemail@seudominio.com>"

# ===== Logging =====
LOG_LEVEL="debug"

# ===== Controle de acesso ao registro =====
# Lista de emails autorizados a criar conta, separados por vírgula.
# Quando não definido ou vazio, qualquer pessoa pode se cadastrar.
# Exemplo: ALLOWED_EMAILS="voce@email.com,amigo@email.com"
ALLOWED_EMAILS=""

# ===== Client-side =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== Build (apenas Docker build, não validar) =====
# SKIP_ENV_VALIDATION="1"
